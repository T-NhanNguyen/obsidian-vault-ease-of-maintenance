# Node
node_modules/
*.log
npm-debug.log*

# Environment — never commit real API keys
.env
.env.local
.env.*.local

# Local user configuration — contains vault paths and optional API keys.
# A fresh clone falls back to config.example.yaml automatically.
config.yaml

# Index data — GraphRAG DBs and pending review state
data/
.note-maintainer/

# Build artifacts — generated by esbuild; the release workflow and
# build-plugin.sh both build main.js fresh, so it must never be committed.
main.js

# OS
.DS_Store

# Tooling / agent state
.pi/
build-plugin.sh

# Private development journal (Obsidian vault) — never commit
.dev-vault/