{
  "name": "obsidian-vault-ease-of-maintenance",
  "version": "1.0.0",
  "description": "AI-powered vault maintenance: GraphRAG indexer + LLM-driven cleanup, triage, and chat agents. Runs entirely inside Obsidian — no server, no Python, no Docker.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint main.ts \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.5.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
